# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Your Supabase project URL (from Settings > API)
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=your_project_url_here

# Your Supabase anon/public key (from Settings > API)
# This is safe to use in client-side code
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Service role key for server-side operations
# WARNING: Never commit this key or expose it in client code!
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Ollama LLM Configuration (Optional - for AI analysis)
# The model to use for agent analysis (default: llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Timeout for LLM requests in seconds (default: 60)
OLLAMA_TIMEOUT_SECONDS=60
